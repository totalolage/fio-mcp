{
  "name": "mcps",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "servers/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "tsc -b servers/fio/tsconfig.build.json",
    "typecheck": "tsc -b packages/core/tsconfig.build.json && tsc -p packages/core/tsconfig.json --noEmit && tsc -p servers/fio/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "generate": "bun run --cwd servers/fio generate",
    "generate:check": "bun run --cwd servers/fio generate:check",
    "check": "bun run typecheck && bun run lint && bun run test",
    "start": "bun run --cwd servers/fio start",
    "ship:image": "sh scripts/ship-image.sh",
    "test:scripts": "sh test/ship-image.test.sh && sh test/core-import-boundary.test.sh",
    "prepare": "effect-tsgo patch --typescript --no-oxlint && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@effect/tsgo": "0.53.3",
    "@effect/vitest": "4.0.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "trustedDependencies": []
}
