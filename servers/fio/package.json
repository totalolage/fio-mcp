{
  "name": "fio-mcp",
  "version": "0.2.0",
  "description": "MCP server for FIO Bank's API Bankovnictví: transactions, statements, and payment orders",
  "type": "module",
  "license": "MIT",
  "bin": {
    "fio-mcp": "dist/main.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "generate": "node scripts/generate-fio-client.ts",
    "generate:check": "bun run generate && git diff --exit-code -- src/generated",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/sql-sqlite-node": "4.0.6",
    "@mcps/core": "workspace:*",
    "effect": "4.0.6",
    "fast-xml-parser": "5.12.0"
  },
  "devDependencies": {
    "@effect/openapi-generator": "4.0.6"
  }
}
