{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "outDir": "dist",
    "plugins": [
      {
        "name": "@effect/language-service",
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectErrorsInTscExitCode": false,
        "allowedUnstableApis": [
          "effect/Stdio",
          "effect/Terminal",
          "effect/ByteSize",
          "@effect/vitest",
          "effect/testing",
          "effect/FileSystem",
          "effect/ai",
          "effect/http",
          "effect/sql",
          "effect/schema",
          "@effect/sql-sqlite-node",
          "@effect/platform-node"
        ],
        "diagnosticSeverity": {
          "schemaClassMissingBrand": "off",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "missingEffectError": "error",
          "missingEffectContext": "error",
          "missingLayerContext": "error",
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "missingStarInYieldEffectGen": "error",
          "missingReturnYieldStar": "error",
          "returnEffectInGen": "error",
          "effectInVoidSuccess": "error",
          "effectInFailure": "error",
          "globalErrorInEffectFailure": "error",
          "globalErrorInEffectCatch": "error",
          "unknownInEffectCatch": "error",
          "tryCatchInEffectGen": "error",
          "runEffectInsideEffect": "error",
          "promiseInEffectSuccess": "error",
          "catchUnfailableEffect": "warning",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalDateInEffect": "warning",
          "globalConsoleInEffect": "error",
          "asyncFunction": "warning",
          "extendsNativeError": "error",
          "layerMergeAllWithDependencies": "error",
          "leakingRequirements": "warning"
        },
        "overrides": [
          {
            "include": [
              "test/**/*.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "asyncFunction": "off"
              }
            }
          }
        ]
      }
    ]
  },
  "include": [
    "src",
    "test",
    "scripts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
